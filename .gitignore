# macOS
.DS_Store

# Xcode
build/
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Generated by xcodegen from project.yml; not a source artifact.
/MonoCl.xcodeproj/
/MonoCl/Info.plist

# Swift Package Manager
.build/
.swiftpm/

# Worktrees and agent scratch
.claude/worktrees/
.claude/settings.local.json
.superpowers/

# Skills under .claude/skills/ describe this project's own procedures, so
# they are shared rather than local.  The negation is needed because the
# global ignore (~/.gitignore) excludes .claude/* wholesale; a repository
# .gitignore takes precedence over it.
!.claude/skills/

# Python bytecode, generated by py_compile when checking Scripts/.
__pycache__/
*.pyc
